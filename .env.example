# Backend engine: "local" (runs completely on your device via Transformers) or "gemini" (via API)
BACKEND=local

# -----------------------------------------------------------------------------
# Local Model Configuration (Used when BACKEND=local)
# -----------------------------------------------------------------------------
# Path to your local Hugging Face model directory (e.g. Qwen3.5-0.8B)
MODEL_PATH=models/Qwen3.5-0.8B
MODEL_DEVICE_MAP=auto
MODEL_LOCAL_FILES_ONLY=true
MODEL_MAX_NEW_TOKENS=4096

# -----------------------------------------------------------------------------
# Optional Cloud Configuration (Used only if BACKEND=gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=4096

# -----------------------------------------------------------------------------
# Document Processing Settings
# -----------------------------------------------------------------------------
RENDER_DPI=144
MAX_PAGES_PER_CALL=1
MAX_TARGETED_RETRIES=1
