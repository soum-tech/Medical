# Gemini API key – get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Flash model (fast, vision-capable, handles images + text)
GEMINI_MODEL=gemini-2.0-flash

# Maximum tokens Gemini may generate per call
GEMINI_MAX_OUTPUT_TOKENS=4096

# Document processing
RENDER_DPI=144
MAX_PAGES_PER_CALL=1
MAX_TARGETED_RETRIES=1
